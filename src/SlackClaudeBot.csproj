<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>slack-claude-bot</AssemblyName>
    <RootNamespace>SlackClaudeBot</RootNamespace>
    <!-- 常駐1プロセスなので Native AOT。公式 Anthropic SDK はリフレクション JSON で AOT 非対応のため、
         Slack / Claude どちらも HttpClient + System.Text.Json ソースジェネレータで直接叩く -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>
</Project>

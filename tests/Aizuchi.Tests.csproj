<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- TUnit。テストプロジェクト自体が実行ファイル(Microsoft.Testing.Platform)なので
         Microsoft.NET.Test.Sdk も VSTest ランナーも要らない。dotnet run で走る -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.66.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Aizuchi.Core/Aizuchi.Core.csproj" />
    <ProjectReference Include="../src/Aizuchi.Slack/Aizuchi.Slack.csproj" />
    <ProjectReference Include="../src/Aizuchi.Claude/Aizuchi.Claude.csproj" />
    <ProjectReference Include="../src/Aizuchi.GitHub/Aizuchi.GitHub.csproj" />
  </ItemGroup>
</Project>
